###
# General settings
###

# Accept the NVIDIA Omniverse EULA by default
ACCEPT_EULA=Y
# NVIDIA Isaac Sim base image
ISAACSIM_BASE_IMAGE=nvcr.io/nvidia/isaac-sim
# NVIDIA Isaac Sim version to use (e.g. 4.5.0)
ISAACSIM_VERSION=4.5.0@sha256:c2f47dc82a7714af08d3766efe80ac9d084c2b37b5d0dfbd074797ec56390fc7
# Derived from the default path in the NVIDIA provided Isaac Sim container
DOCKER_ISAACSIM_ROOT_PATH=/home/olympus/isaac-sim
# The Isaac Lab path in the container
DOCKER_ISAACLAB_PATH=/home/olympus/workspace/IsaacLab
# Docker user directory - by default this is the root user's home directory
DOCKER_USER_HOME=/home/olympus

DOCKER_OLYMPUSLAB_PATH=/home/olympus/workspace/Olympus-Lab

DOCKER_NETWORK=host

COMPOSE_PROJECT_NAME=olympus-lab



# Nvidia Dockerfiles: https://github.com/NVIDIA-Omniverse/IsaacSim-dockerfiles
# Please check above link for license information.

# Base image
ARG ISAACSIM_BASE_IMAGE_ARG
ARG ISAACSIM_VERSION_ARG
FROM ${ISAACSIM_BASE_IMAGE_ARG}:${ISAACSIM_VERSION_ARG} AS base
ENV ISAACSIM_VERSION=${ISAACSIM_VERSION_ARG}

USER root


# Set default RUN shell to bash
SHELL ["/bin/bash", "-c"]

# Adds labels to the Dockerfile
LABEL version="1.1"
LABEL description="Dockerfile for building and running the Isaac Lab framework inside Isaac Sim container image."

# Arguments
# Path to Isaac Sim root folder
ARG ISAACSIM_ROOT_PATH_ARG
ENV ISAACSIM_ROOT_PATH=${ISAACSIM_ROOT_PATH_ARG}
# Path to the Isaac Lab directory
ARG ISAACLAB_PATH_ARG
ENV ISAACLAB_PATH=${ISAACLAB_PATH_ARG}

# Home dir of docker USER
ARG DOCKER_USER_HOME_ARG
ENV DOCKER_USER_HOME=${DOCKER_USER_HOME_ARG}

ARG DOCKER_USER_ID_ARG
ARG DOCKER_USER_GID_ARG

# Set environment variables
ENV LANG=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive


# Install dependencies and remove cache
RUN --mount=type=cache,target=/var/cache/apt \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libglib2.0-0 \
    ncurses-term \
    openssh-client && \
    apt -y autoremove && apt clean autoclean && \
    rm -rf /var/lib/apt/lists/*


# Remove existing USER and group with UID/GID 1000 if they exist
RUN userdel -f $(getent passwd 1000 | cut -d: -f1) 2>/dev/null || true
RUN groupdel -f $(getent group 1000 | cut -d: -f1) 2>/dev/null || true

RUN groupadd -g ${DOCKER_USER_GID_ARG} olympus && useradd --no-log-init -u ${DOCKER_USER_ID_ARG} -g ${DOCKER_USER_GID_ARG} olympus

RUN mkdir -p /home/olympus && chown olympus:olympus /home/olympus

# move isaac-sim folders to users home
RUN mv /isaac-sim ${ISAACSIM_ROOT_PATH}
#RUN chown -R olympus:olympus ${ISAACSIM_ROOT_PATH}
#this is slow
RUN find /home/olympus/isaac-sim -print0 | xargs -0 -n 1000 -P 4 chown olympus:olympus


USER olympus

# Set up a symbolic link between the installed Isaac Sim root folder and _isaac_sim in the Isaac Lab directory
WORKDIR ${DOCKER_USER_HOME}/workspace
RUN git clone --branch v2.1.1 --depth 1 https://github.com/isaac-sim/IsaacLab.git
WORKDIR ${ISAACLAB_PATH}

RUN ln -sf ${ISAACSIM_ROOT_PATH} ${ISAACLAB_PATH}/_isaac_sim

# Install toml dependency
RUN ${ISAACLAB_PATH}/isaaclab.sh -p -m pip install toml

USER root
# Install apt dependencies for extensions that declare them in their extension.toml
RUN --mount=type=cache,target=/var/cache/apt \
    ${ISAACLAB_PATH}/isaaclab.sh -p ${ISAACLAB_PATH}/tools/install_deps.py apt ${ISAACLAB_PATH}/source && \
    apt -y autoremove && apt clean autoclean && \
    rm -rf /var/lib/apt/lists/*



# for singularity usage, have to create the directories that will binded
USER olympus
RUN mkdir -p ${ISAACSIM_ROOT_PATH}/kit/cache && \
    mkdir -p ${DOCKER_USER_HOME}/.cache/ov && \
    mkdir -p ${DOCKER_USER_HOME}/.cache/pip && \
    mkdir -p ${DOCKER_USER_HOME}/.cache/nvidia/GLCache &&  \
    mkdir -p ${DOCKER_USER_HOME}/.nv/ComputeCache && \
    mkdir -p ${DOCKER_USER_HOME}/.nvidia-omniverse/logs && \
    mkdir -p ${DOCKER_USER_HOME}/.local/share/ov/data && \
    mkdir -p ${DOCKER_USER_HOME}/Documents

RUN chown -R olympus:olympus ${ISAACSIM_ROOT_PATH}/kit/cache && \
    chown -R olympus:olympus ${DOCKER_USER_HOME}/.cache/ov && \
    chown -R olympus:olympus ${DOCKER_USER_HOME}/.cache/pip && \
    chown -R olympus:olympus ${DOCKER_USER_HOME}/.cache/nvidia/GLCache &&  \
    chown -R olympus:olympus ${DOCKER_USER_HOME}/.nv/ComputeCache && \
    chown -R olympus:olympus ${DOCKER_USER_HOME}/.nvidia-omniverse/logs && \
    chown -R olympus:olympus ${DOCKER_USER_HOME}/.local/share/ov/data && \
    chown -R olympus:olympus ${DOCKER_USER_HOME}/Documents
    

USER root
# for singularity usage, create NVIDIA binary placeholders
RUN touch /bin/nvidia-smi && \
    touch /bin/nvidia-debugdump && \
    touch /bin/nvidia-persistenced && \
    touch /bin/nvidia-cuda-mps-control && \
    touch /bin/nvidia-cuda-mps-server && \
    touch /etc/localtime && \
    mkdir -p /var/run/nvidia-persistenced && \
    touch /var/run/nvidia-persistenced/socket

USER olympus    
# installing Isaac Lab dependencies
# use pip caching to avoid reinstalling large packages
# flatdict 4.0.1 (isaaclab dep) is sdist-only and needs pkg_resources, removed in setuptools>=81
RUN ${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip install "setuptools<81" && \
    ${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip install --no-build-isolation flatdict==4.0.1
RUN --mount=type=cache,target=${DOCKER_USER_HOME}/.cache/pip \
    ${ISAACLAB_PATH}/isaaclab.sh --install

# aliasing isaaclab.sh and python for convenience
RUN echo "export ISAACLAB_PATH=${ISAACLAB_PATH}" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "export ISAACSIM_PATH=${ISAACSIM_ROOT_PATH}" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "export OLYMPUSLAB_PATH=${DOCKER_USER_HOME}/workspace/Olympus-Lab" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias isaaclab=${ISAACLAB_PATH}/isaaclab.sh" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias python=${ISAACLAB_PATH}/_isaac_sim/python.sh" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias python3=${ISAACLAB_PATH}/_isaac_sim/python.sh" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias pip='${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip'" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias pip3='${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip'" >> ${DOCKER_USER_HOME}/.bashrc && \
    echo "alias tensorboard='${ISAACLAB_PATH}/_isaac_sim/python.sh ${ISAACLAB_PATH}/_isaac_sim/tensorboard'" >> ${HOME}/.bashrc && \
    echo "export TZ=$(date +%Z)" >> ${DOCKER_USER_HOME}/.bashrc

# make working directory as the Isaac Lab directory
# this is the default directory when the container is run

RUN ${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip install jax[cuda12]==0.4.35
RUN ${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip install jaxsim==0.6.1
# keep numpy<2 (Isaac Sim 4.5 modules are built against numpy 1), so also cap packages whose
# newer releases require numpy>=2; mashumaro>3.15 needs a newer typing_extensions than the
# 4.10 that Isaac Sim prebundles and puts first on the path
RUN ${ISAACLAB_PATH}/_isaac_sim/python.sh -m pip install "numpy<2" "ml-dtypes<0.6" "opencv-python<4.12" "mashumaro==3.15"

#necesary dependencies for jaxsim
USER root
# Install necessary packages
RUN apt-get update && \
    apt-get install -y lsb-release wget gnupg && \
    rm -rf /var/lib/apt/lists/*

# Download the GPG key
RUN wget https://packages.osrfoundation.org/gazebo.gpg -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg

# Add the Gazebo repository
RUN echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
    | tee /etc/apt/sources.list.d/gazebo-stable.list > /dev/null

# Update package lists and install Gazebo
RUN apt-get update && \
    apt-get install -y --no-install-recommends libsdformat13 gz-tools2 && \
    rm -rf /var/lib/apt/lists/*

USER olympus


RUN ${ISAACLAB_PATH}/_isaac_sim/python.sh .vscode/tools/setup_vscode.py

COPY docker/entrypoint.sh ${DOCKER_USER_HOME}/entrypoint.sh
USER root
RUN chmod +x ${DOCKER_USER_HOME}/entrypoint.sh
USER olympus

WORKDIR ${DOCKER_USER_HOME}/workspace/Olympus-Lab